{
    "name": "waskita/security",
    "description": "Automated Laravel Security Testing & Vulnerability Audit Engine for AI Agents & CI/CD — Waskita melihat titik buta keamanan yang luput dari perhatian",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "security",
        "audit",
        "vulnerability",
        "scanner",
        "owasp",
        "ci-cd",
        "static-analysis",
        "waskita"
    ],
    "authors": [
        {
            "name": "Waskita Team",
            "email": "team@waskita.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "nikic/php-parser": "^5.0",
        "symfony/yaml": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Waskita\\Security\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waskita\\Security\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Waskita\\Security\\WaskitaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
